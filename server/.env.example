# PORT
PORT=1700

# Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173
BASE_URL=http://localhost:1700

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/RevisionApp?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_hex_string_here
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI & LLM Services
GEMINI_API_KEY=your_gemini_api_key_here

# Email Delivery (Brevo / Sendinblue)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password

# Cron Security
CRON_SECRET=your_custom_cron_secret_string_here
